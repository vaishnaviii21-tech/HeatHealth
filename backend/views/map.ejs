<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pune Heat-Health Risk Map</title>

  <link
    rel="stylesheet"
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  >

  <style>
    * { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      background: #f4f7fb;
      color: #182641;
    }

    .map-navbar {
      min-height: 70px;
      padding: 12px 30px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      background: #fff;
      border-bottom: 1px solid #e4eaf2;
    }

    .map-brand {
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 19px;
      font-weight: 700;
    }

    .map-brand-icon {
      color: #e23c43;
      font-size: 30px;
    }

    .map-navbar nav {
      display: flex;
      gap: 27px;
    }

    .map-navbar nav a {
      text-decoration: none;
      color: #35435a;
      font-size: 13px;
    }

    .map-layout {
      display: grid;
      grid-template-columns: 260px minmax(0, 1fr);
      gap: 17px;
      padding: 18px;
      height: calc(100vh - 70px);
      min-height: 520px;
    }

    .map-sidebar,
    .map-container {
      background: #fff;
      border: 1px solid #e0e7ef;
      border-radius: 12px;
      box-shadow: 0 3px 12px rgba(28, 52, 84, 0.05);
    }

    .map-sidebar {
      padding: 20px 17px;
      overflow-y: auto;
    }

    .map-sidebar h2 {
      font-size: 17px;
      margin: 0 0 7px;
    }

    .map-subtitle {
      font-size: 12px;
      line-height: 1.5;
      color: #68768b;
      margin-bottom: 25px;
    }

    .map-section-title {
      font-size: 14px;
      font-weight: 700;
      margin: 20px 0 15px;
    }

    .map-legend-item {
      display: flex;
      align-items: center;
      gap: 12px;
      margin: 15px 0;
      font-size: 12px;
      color: #27364c;
    }

    .risk-dot {
      width: 23px;
      height: 23px;
      border-radius: 50%;
      flex-shrink: 0;
    }

    .risk-low { background: #65bd54; }
    .risk-moderate { background: #ffdc45; }
    .risk-high { background: #f79438; }
    .risk-very-high { background: #e63940; }

    .map-divider {
      border: none;
      border-top: 1px solid #e4e9f0;
      margin: 23px 0;
    }

    .map-layer {
      display: flex;
      align-items: center;
      gap: 10px;
      margin: 14px 0;
      font-size: 12px;
      color: #28374d;
      cursor: pointer;
    }

    .map-layer input {
      width: 16px;
      height: 16px;
      accent-color: #2878e7;
      cursor: pointer;
    }

    .map-container {
      position: relative;
      min-width: 0;
      overflow: hidden;
    }

    #riskMap {
      height: 100%;
      width: 100%;
      background: #e8edf0;
    }

    .map-floating-title {
      position: absolute;
      z-index: 500;
      top: 15px;
      left: 60px;
      padding: 12px 16px;
      background: rgba(255,255,255,.96);
      border-radius: 8px;
      box-shadow: 0 2px 10px rgba(0,0,0,.12);
      font-size: 14px;
      font-weight: 700;
      pointer-events: none;
    }

    .map-disclaimer {
      position: absolute;
      z-index: 500;
      bottom: 12px;
      left: 12px;
      background: rgba(255,255,255,.94);
      padding: 8px 10px;
      border-radius: 5px;
      font-size: 10px;
      color: #526176;
      max-width: calc(100% - 24px);
    }

    .area-label {
      background: transparent;
      border: none;
      box-shadow: none;
      color: #192437;
      font-size: 12px;
      font-weight: 700;
      text-shadow:
        -1px -1px 2px white,
        1px 1px 2px white,
        0 0 4px white;
    }

    .area-label::before {
      display: none;
    }

    .risk-popup h3 {
      font-size: 16px;
      margin: 0 0 10px;
      color: #182641;
    }

    .risk-popup p {
      margin: 8px 0;
      font-size: 12px;
    }

    .popup-risk {
      font-size: 12px;
      font-weight: 700;
      margin-bottom: 12px;
    }

    .view-analysis {
      display: inline-block;
      background: #2675e8;
      color: white !important;
      text-decoration: none;
      padding: 10px 15px;
      border-radius: 6px;
      font-size: 12px;
      font-weight: 600;
    }

    .view-analysis:hover {
      background: #185bc0;
    }

    @media (max-width: 720px) {
      .map-navbar {
        padding: 13px;
        flex-wrap: wrap;
      }

      .map-brand {
        font-size: 15px;
      }

      .map-navbar nav {
        gap: 14px;
      }

      .map-layout {
        grid-template-columns: 1fr;
        height: auto;
        padding: 10px;
      }

      .map-sidebar {
        overflow: visible;
      }

      .map-container {
        height: 65vh;
        min-height: 430px;
      }
    }
  </style>
</head>

<body>

  <header class="map-navbar">
    <div class="map-brand">
      <span class="map-brand-icon">♨</span>
      <span>Hyperlocal Heat-Health Risk Prediction</span>
    </div>

    <nav>
      <a href="/">Home</a>
      <a href="/login">About</a>
      <a href="/login">Logout</a>
    </nav>
  </header>

  <main class="map-layout">

    <aside class="map-sidebar">
      <h2>Pune Heat-Health Risk Map</h2>
      <div class="map-subtitle">
        Click on any area to view details.
      </div>

      <div class="map-section-title">Risk Level Legend</div>

      <div class="map-legend-item">
        <span class="risk-dot risk-low"></span>
        <span>Low Risk</span>
      </div>

      <div class="map-legend-item">
        <span class="risk-dot risk-moderate"></span>
        <span>Moderate Risk</span>
      </div>

      <div class="map-legend-item">
        <span class="risk-dot risk-high"></span>
        <span>High Risk</span>
      </div>

      <div class="map-legend-item">
        <span class="risk-dot risk-very-high"></span>
        <span>Very High Risk</span>
      </div>

      <hr class="map-divider">

      <div class="map-section-title">Map Layers</div>

      <label class="map-layer">
        <input type="checkbox" id="riskLayer" checked>
        <span>Heat Risk (Demo Output)</span>
      </label>

      <label class="map-layer">
        <input type="checkbox" id="temperatureLayer">
        <span>Temperature</span>
      </label>

      <label class="map-layer">
        <input type="checkbox" id="humidityLayer">
        <span>Humidity</span>
      </label>

      <label class="map-layer">
        <input type="checkbox" id="vegetationLayer">
        <span>Vegetation Cover</span>
      </label>

      <hr class="map-divider">

      <div class="map-subtitle">
        Demo map: risk categories are illustrative and are not live AI predictions.
      </div>
    </aside>

    <section class="map-container">
      <div class="map-floating-title">
        Pune City · Heat Risk Zones
      </div>

      <div id="riskMap"></div>

      <div class="map-disclaimer">
        Illustrative GeoJSON polygons · Pune, Maharashtra
      </div>
    </section>

  </main>

  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

  <script>
    // Initialise Leaflet map
    const map = L.map("riskMap").setView([18.5204, 73.8567], 12);

    // OpenStreetMap base map
    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
      maxZoom: 19,
      attribution: "&copy; OpenStreetMap contributors"
    }).addTo(map);

    // Sample GeoJSON polygons for UI demonstration.
    // Replace these geometries with verified Pune area boundaries
    // before using them for real risk analysis.
    const riskGeoJSON = {
      "type": "FeatureCollection",
      "features": [
        {
          "type": "Feature",
          "properties": {"name":"Hinjawadi","risk":"Moderate"},
          "geometry":{"type":"Polygon","coordinates":[[
            [73.720,18.590],[73.755,18.610],[73.785,18.590],
            [73.790,18.560],[73.770,18.535],[73.735,18.545],
            [73.720,18.590]
          ]]}
        },
        {
          "type": "Feature",
          "properties": {"name":"Baner","risk":"High"},
          "geometry":{"type":"Polygon","coordinates":[[
            [73.770,18.585],[73.800,18.600],[73.825,18.570],
            [73.815,18.535],[73.790,18.535],[73.770,18.585]
          ]]}
        },
        {
          "type": "Feature",
          "properties": {"name":"Aundh","risk":"Moderate"},
          "geometry":{"type":"Polygon","coordinates":[[
            [73.800,18.600],[73.835,18.605],[73.855,18.575],
            [73.840,18.550],[73.815,18.535],[73.825,18.570],
            [73.800,18.600]
          ]]}
        },
        {
          "type": "Feature",
          "properties": {"name":"Kothrud","risk":"Low"},
          "geometry":{"type":"Polygon","coordinates":[[
            [73.770,18.535],[73.790,18.535],[73.815,18.510],
            [73.805,18.480],[73.770,18.485],[73.750,18.510],
            [73.770,18.535]
          ]]}
        },
        {
          "type": "Feature",
          "properties": {"name":"Shivajinagar","risk":"Very High"},
          "geometry":{"type":"Polygon","coordinates":[[
            [73.815,18.535],[73.840,18.550],[73.855,18.535],
            [73.875,18.520],[73.860,18.495],[73.825,18.500],
            [73.805,18.515],[73.815,18.535]
          ]]}
        },
        {
          "type": "Feature",
          "properties": {"name":"Yerawada","risk":"High"},
          "geometry":{"type":"Polygon","coordinates":[[
            [73.855,18.575],[73.885,18.580],[73.905,18.550],
            [73.895,18.520],[73.875,18.520],[73.855,18.535],
            [73.855,18.575]
          ]]}
        },
        {
          "type": "Feature",
          "properties": {"name":"Deccan","risk":"High"},
          "geometry":{"type":"Polygon","coordinates":[[
            [73.805,18.515],[73.825,18.500],[73.860,18.495],
            [73.870,18.470],[73.845,18.455],[73.815,18.475],
            [73.805,18.515]
          ]]}
        },
        {
          "type": "Feature",
          "properties": {"name":"Camp","risk":"Moderate"},
          "geometry":{"type":"Polygon","coordinates":[[
            [73.860,18.495],[73.875,18.520],[73.895,18.520],
            [73.915,18.490],[73.900,18.465],[73.870,18.470],
            [73.860,18.495]
          ]]}
        },
        {
          "type": "Feature",
          "properties": {"name":"Hadapsar","risk":"High"},
          "geometry":{"type":"Polygon","coordinates":[[
            [73.895,18.520],[73.925,18.515],[73.945,18.485],
            [73.935,18.455],[73.910,18.445],[73.900,18.465],
            [73.915,18.490],[73.895,18.520]
          ]]}
        },
        {
          "type": "Feature",
          "properties": {"name":"Karve Nagar","risk":"Moderate"},
          "geometry":{"type":"Polygon","coordinates":[[
            [73.770,18.485],[73.805,18.480],[73.815,18.475],
            [73.845,18.455],[73.835,18.435],[73.800,18.430],
            [73.775,18.450],[73.770,18.485]
          ]]}
        },
        {
          "type": "Feature",
          "properties": {"name":"Swargate","risk":"High"},
          "geometry":{"type":"Polygon","coordinates":[[
            [73.845,18.455],[73.870,18.470],[73.900,18.465],
            [73.910,18.445],[73.895,18.425],[73.860,18.425],
            [73.835,18.435],[73.845,18.455]
          ]]}
        },
        {
          "type": "Feature",
          "properties": {"name":"Kondhwa","risk":"Low"},
          "geometry":{"type":"Polygon","coordinates":[[
            [73.860,18.425],[73.895,18.425],[73.910,18.445],
            [73.935,18.455],[73.920,18.420],[73.895,18.405],
            [73.870,18.405],[73.860,18.425]
          ]]}
        },
        {
          "type": "Feature",
          "properties": {"name":"Bibwewadi","risk":"High"},
          "geometry":{"type":"Polygon","coordinates":[[
            [73.800,18.430],[73.835,18.435],[73.860,18.425],
            [73.870,18.405],[73.850,18.390],[73.820,18.395],
            [73.800,18.410],[73.800,18.430]
          ]]}
        }
      ]
    };

    const riskColors = {
      "Low": "#65bd54",
      "Moderate": "#ffdc45",
      "High": "#f79438",
      "Very High": "#e63940"
    };

    function styleArea(feature) {
      return {
        color: "#ffffff",
        weight: 2,
        opacity: 1,
        fillColor: riskColors[feature.properties.risk],
        fillOpacity: 0.82
      };
    }

    function addAreaDetails(feature, layer) {
      const area = feature.properties;
      const center = layer.getBounds().getCenter();

      layer.bindTooltip(area.name, {
        permanent: true,
        direction: "center",
        className: "area-label"
      });

      layer.bindPopup(`
        <div class="risk-popup">
          <h3>${area.name}</h3>
          <div class="popup-risk" style="color:${riskColors[area.risk]}">
            ● Risk Level: ${area.risk}
          </div>
          <p>Area: ${area.name}</p>
          <p>Risk category: ${area.risk}</p>
          <a class="view-analysis" href="/analysis">View Analysis</a>
        </div>
      `);

      layer.on("mouseover", function () {
        this.setStyle({
          color: "#ffffff",
          weight: 3,
          fillOpacity: 0.95
        });
      });

      layer.on("mouseout", function () {
        geojsonLayer.resetStyle(this);
      });
    }

    const geojsonLayer = L.geoJSON(riskGeoJSON, {
      style: styleArea,
      onEachFeature: addAreaDetails
    }).addTo(map);

    map.fitBounds(geojsonLayer.getBounds(), { padding: [20, 20] });

    // Heat-risk layer toggle
    document.getElementById("riskLayer").addEventListener("change", function () {
      if (this.checked) {
        geojsonLayer.addTo(map);
      } else {
        map.removeLayer(geojsonLayer);
      }
    });

    // These layers are placeholders until actual datasets are connected.
    ["temperatureLayer", "humidityLayer", "vegetationLayer"].forEach(function (id) {
      document.getElementById(id).addEventListener("change", function () {
        if (this.checked) {
          alert("This layer is not connected to a data source yet.");
          this.checked = false;
        }
      });
    });
  </script>

</body>
</html>