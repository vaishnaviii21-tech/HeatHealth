
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Select City | Heat-Health Risk</title>
  <link rel="stylesheet" href="/css/style.css">

  <style>
    .city-page {
      margin: 0;
      min-height: 100vh;
      background: #f0f7fc;
      font-family: Arial, sans-serif;
      color: #102e50;
    }

    .city-page * {
      box-sizing: border-box;
    }

    .city-page .city-header {
      height: 47px;
      padding: 0 5%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: #f8fcff;
      border: 1px solid #d9e8f3;
    }

    .city-page .city-logo {
      display: flex;
      align-items: center;
      gap: 9px;
      font-size: 12px;
      font-weight: 700;
      color: #102e50;
      text-decoration: none;
    }

    .city-page .thermometer {
      font-size: 27px;
    }

    .city-page .city-header nav {
      display: flex;
      gap: 25px;
    }

    .city-page .city-header nav a {
      font-size: 11px;
      color: #102e50;
      text-decoration: none;
    }

    .city-page .city-main {
      min-height: calc(100vh - 47px);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 22px 16px;
      background: linear-gradient(135deg, #eef7fd, #f9fcff);
    }

    .city-page .city-card {
      width: 100%;
      max-width: 900px;
      min-height: 650px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      overflow: hidden;
      background: #f9fcff;
      border: 1px solid #d4e5f1;
      border-radius: 12px;
      box-shadow: 0 5px 18px rgba(32, 72, 105, .10);
    }

    .city-page .city-content {
      padding: 62px 20px 38px;
      text-align: center;
    }

    .city-page .city-content h1 {
      margin: 0 0 7px;
      font-size: 25px;
      line-height: 1.3;
      color: #102e50;
    }

    .city-page .city-subtitle {
      margin: 0 0 26px;
      font-size: 14px;
      color: #5a6877;
    }

    .city-page .city-form {
      width: 100%;
      max-width: 330px;
      margin: 0 auto;
    }

    .city-page .city-select-wrapper {
      height: 44px;
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 0 12px;
      border: 1px solid #d0deea;
      border-radius: 7px;
      background: #f9fcff;
    }

    .city-page .location-icon {
      font-size: 17px;
    }

    .city-page .city-select-wrapper select {
      width: 100%;
      min-width: 0;
      border: none;
      outline: none;
      background: transparent;
      color: #172b40;
      font-size: 13px;
      cursor: pointer;
    }

    .city-page .continue-button {
      width: 100%;
      height: 38px;
      margin-top: 19px;
      border: none;
      border-radius: 5px;
      color: white;
      background: #08477f;
      font-size: 14px;
      cursor: pointer;
    }

    .city-page .continue-button:hover {
      background: #06345d;
    }

    /* Bottom skyline */
    .city-page .pune-illustration {
      position: relative;
      min-height: 205px;
      padding-top: 12px;
      overflow: hidden;
      text-align: center;
      background: linear-gradient(to bottom, #f8fcff, #edf8f7);
      border-top: 1px solid #e0ebf2;
    }

    .city-page .skyline-image {
      display: block;
      width: 100%;
      height: 132px;
      object-fit: contain;
      object-position: center bottom;
    }

    .city-page .city-caption {
      padding: 4px 10px 12px;
      border-top: 1px solid #d5e5e4;
    }

    .city-page .city-caption h2 {
      margin: 3px 0;
      font-size: 21px;
      letter-spacing: 2px;
      color: #304e65;
    }

    .city-page .city-caption p {
      margin: 0;
      font-size: 11px;
      letter-spacing: 1.5px;
      color: #5c7584;
    }

    @media (max-width: 600px) {
      .city-page .city-header {
        height: auto;
        min-height: 52px;
        padding: 10px 12px;
        flex-wrap: wrap;
        gap: 10px;
      }

      .city-page .city-logo {
        font-size: 11px;
      }

      .city-page .city-header nav {
        gap: 16px;
      }

      .city-page .city-main {
        padding: 12px;
      }

      .city-page .city-card {
        min-height: 600px;
      }

      .city-page .city-content {
        padding: 55px 15px 35px;
      }

      .city-page .city-content h1 {
        font-size: 23px;
      }

      .city-page .pune-illustration {
        min-height: 180px;
      }

      .city-page .skyline-image {
        height: 110px;
      }
    }
  </style>
</head>

<body class="city-page">

  <header class="city-header">
    <a href="/city" class="city-logo">
      <span class="thermometer">🌡️</span>
      <span>Hyperlocal Heat-Health Risk Prediction</span>
    </a>

    <nav>
      <a href="/">Home</a>
      <a href="/#about">About</a>
      <a href="/login">Logout</a>
    </nav>
  </header>

  <main class="city-main">
    <section class="city-card">

      <div class="city-content">
        <h1>Select Your City</h1>

        <p class="city-subtitle">
          Choose a city to view heat-health risk analysis
        </p>

        <form class="city-form" action="/city" method="POST">
          <div class="city-select-wrapper">
            <span class="location-icon">📍</span>

            <select name="city" id="city" required>
              <option value="Pune, Maharashtra"
                <%= selectedCity === "Pune, Maharashtra" ? "selected" : "" %>>
                Pune, Maharashtra
              </option>

              <option value="Mumbai, Maharashtra"
                <%= selectedCity === "Mumbai, Maharashtra" ? "selected" : "" %>>
                Mumbai, Maharashtra
              </option>

              <option value="Nagpur, Maharashtra"
                <%= selectedCity === "Nagpur, Maharashtra" ? "selected" : "" %>>
                Nagpur, Maharashtra
              </option>

              <option value="Nashik, Maharashtra"
                <%= selectedCity === "Nashik, Maharashtra" ? "selected" : "" %>>
                Nashik, Maharashtra
              </option>
            </select>
          </div>

          <button class="continue-button" type="submit">
            Continue
          </button>
        </form>
      </div>

      <div class="pune-illustration">

        <!-- Replace with your own line-art skyline image -->
        <img
          class="skyline-image"
          src="/images/pune-skyline.png"
          alt="Illustration of Pune city skyline"
          onerror="this.style.display='none'"
        >

        <div class="city-caption">
          <h2>PUNE</h2>
          <p>A SAFER, HEALTHIER TOMORROW</p>
        </div>

      </div>

    </section>
  </main>

</body>
</html>