  <style>
    * { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      color: #123b65;
      background: #f0f7fd;
    }

    .navbar {
      height: 72px;
      background: #fff;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 36px;
      box-shadow: 0 2px 8px rgba(20, 55, 90, 0.06);
    }

    .brand {
      font-size: 16px;
      font-weight: 700;
      color: #083b70;
      text-decoration: none;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 34px;
    }

    .nav-links a {
      color: #123b65;
      font-size: 13px;
      text-decoration: none;
    }

    .page-layout {
      display: grid;
      grid-template-columns: 285px minmax(0, 1fr);
      gap: 14px;
      padding: 18px;
      min-height: calc(100vh - 72px);
    }

    .sidebar {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .card {
      background: #fff;
      border: 1px solid #d9e8f5;
      border-radius: 13px;
      padding: 17px;
      box-shadow: 0 4px 14px rgba(30, 70, 110, 0.06);
    }

    .card h3 {
      font-size: 14px;
      margin: 0 0 15px;
      color: #123b65;
    }

    .city-value {
      padding: 14px 12px;
      background: #e5f1ff;
      border-radius: 8px;
      font-size: 13px;
    }

    .field-label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      margin-bottom: 10px;
    }

    select, input {
      width: 100%;
      min-width: 0;
      height: 44px;
      border: 1px solid #cbdced;
      border-radius: 7px;
      padding: 0 12px;
      background: white;
      color: #123b65;
      font-size: 14px;
      outline-color: #0d4b82;
    }

    .primary-btn {
      width: 100%;
      height: 41px;
      border: none;
      border-radius: 7px;
      background: #104d83;
      color: white;
      font-weight: 700;
      font-size: 14px;
      cursor: pointer;
      margin-top: 12px;
    }

    .primary-btn:hover {
      background: #083b69;
    }

    .help-card {
      background: #eff7ff;
    }

    .help-card h3 {
      font-size: 15px;
    }

    .help-card ol {
      padding-left: 19px;
      margin: 0;
      font-size: 12px;
      line-height: 1.9;
    }

    .map-panel {
      min-width: 0;
      min-height: 650px;
      position: relative;
      background: #e9f2f7;
      border: 1px solid #d9e8f5;
      border-radius: 13px;
      overflow: hidden;
      box-shadow: 0 4px 14px rgba(30, 70, 110, 0.06);
    }

    .map-search {
      position: absolute;
      z-index: 500;
      top: 13px;
      left: 52px;
      display: flex;
      gap: 7px;
      width: min(350px, calc(100% - 70px));
    }

    .map-search input {
      flex: 1;
      width: 0;
    }

    .search-btn {
      height: 40px;
      padding: 0 14px;
      background: white;
      border: 1px solid #cbdced;
      border-radius: 7px;
      color: #123b65;
      cursor: pointer;
    }

    #areaMap {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      min-height: 650px;
      z-index: 1;
    }

    .selected-area-tag {
      position: absolute;
      z-index: 500;
      left: 12px;
      bottom: 12px;
      background: white;
      border-radius: 7px;
      padding: 10px 13px;
      box-shadow: 0 2px 8px #0000001a;
      font-size: 12px;
    }

    .risk-legend {
      position: absolute;
      z-index: 500;
      right: 12px;
      bottom: 12px;
      background: white;
      border-radius: 8px;
      padding: 11px;
      box-shadow: 0 2px 8px #0000001a;
      font-size: 12px;
      line-height: 1.9;
    }

    .legend-dot {
      display: inline-block;
      width: 10px;
      height: 10px;
      border-radius: 50%;
      margin-right: 6px;
    }

    .status-message {
      margin-top: 9px;
      color: #a33a2b;
      font-size: 12px;
    }

    @media (max-width: 760px) {
      .navbar {
        padding: 0 16px;
        height: auto;
        min-height: 65px;
        gap: 12px;
        flex-wrap: wrap;
      }

      .brand { font-size: 14px; }

      .nav-links {
        gap: 14px;
        padding: 10px 0;
      }

      .page-layout {
        grid-template-columns: 1fr;
        padding: 12px;
      }

      .map-panel {
        min-height: 480px;
      }

      #areaMap {
        min-height: 480px;
      }
    }
  </style>

</head>

