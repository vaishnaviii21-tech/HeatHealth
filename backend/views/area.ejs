  </main>

  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

  <script>
    const params = new URLSearchParams(window.location.search);
    const city = params.get("city") || "Pune, Maharashtra";

    document.getElementById("cityName").textContent = city;

    const areas = {
      "Shivajinagar": { coords: [18.5308, 73.8475], risk: "High", color: "#e53935" },
      "Kothrud": { coords: [18.5074, 73.8077], risk: "Medium", color: "#fb8c00" },
      "Hadapsar": { coords: [18.5089, 73.9259], risk: "High", color: "#e53935" },
      "Hinjawadi": { coords: [18.5913, 73.7389], risk: "Medium", color: "#fb8c00" },
      "Koregaon Park": { coords: [18.5362, 73.8939], risk: "Low", color: "#2e9d50" },
      "Pune Station": { coords: [18.5289, 73.8744], risk: "High", color: "#e53935" },
      "Swargate": { coords: [18.5018, 73.8636], risk: "Medium", color: "#fb8c00" },
      "Baner": { coords: [18.5590, 73.7868], risk: "Low", color: "#2e9d50" },
      "Wakad": { coords: [18.5975, 73.7639], risk: "Medium", color: "#fb8c00" },
      "Katraj": { coords: [18.4575, 73.8677], risk: "Medium", color: "#fb8c00" }
    };

    const map = L.map("areaMap").setView([18.5204, 73.8567], 12);

    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
      maxZoom: 19,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
    }).addTo(map);

    const markers = {};

    Object.entries(areas).forEach(([name, area]) => {
      L.circle(area.coords, {
        radius: 650,
        color: area.color,
        fillColor: area.color,
        fillOpacity: 0.25,
        weight: 2
      }).addTo(map);

      const marker = L.marker(area.coords).addTo(map);
      marker.bindPopup(
        "<strong>" + name + "</strong><br>" +
        "Sample heat-risk level: <strong>" + area.risk + "</strong><br>" +
        "<small>Illustrative demo data, not a live prediction.</small>"
      );

      marker.on("click", () => selectArea(name, false));
      markers[name.toLowerCase()] = marker;
    });

    const areaSelect = document.getElementById("areaSelect");
    const statusMessage = document.getElementById("statusMessage");

    function selectArea(name, showMessage = true) {
      const matched = Object.keys(areas).find(
        item => item.toLowerCase() === name.trim().toLowerCase()
      );

      if (!matched) {
        statusMessage.textContent =
          "Area not in the demo list. Try Shivajinagar, Kothrud, Hadapsar or Baner.";
        return;
      }

      areaSelect.value = matched;
      document.getElementById("selectedAreaLabel").textContent = matched;
      statusMessage.textContent = "";

      const area = areas[matched];
      map.flyTo(area.coords, 14, { duration: 0.8 });
      markers[matched.toLowerCase()].openPopup();

      if (showMessage) {
        statusMessage.textContent = "Showing " + matched + " on the map.";
      }
    }

    document.getElementById("showMapBtn").addEventListener("click", () => {
      selectArea(areaSelect.value);
    });

    document.getElementById("searchForm").addEventListener("submit", event => {
      event.preventDefault();
      const query = document.getElementById("areaSearch").value.trim();

      if (!query) {
        statusMessage.textContent = "Please enter an area name.";
        return;
      }

      selectArea(query);
    });

    document.getElementById("analyseBtn").addEventListener("click", () => {
      const selectedArea = areaSelect.value;
      window.location.href =
        "/analysis?city=" + encodeURIComponent(city) +
        "&area=" + encodeURIComponent(selectedArea);
    });

    // Load a requested area from the URL, if provided.
    const requestedArea = params.get("area");
    if (requestedArea && areas[requestedArea]) {
      selectArea(requestedArea, false);
    } else {
      selectArea("Shivajinagar", false);
    }

    setTimeout(() => map.invalidateSize(), 200);
  </script>

